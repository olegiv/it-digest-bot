[Unit]
Description=it-digest-bot — release watchers
After=network-online.target
Wants=network-online.target

# Post a Telegram alert on nonzero exit (see it-digest-notify@.service).
OnFailure=it-digest-notify@%N.service

[Service]
Type=oneshot
User=it-digest
Group=it-digest
EnvironmentFile=/etc/it-digest/env
ExecStart=/usr/local/bin/digest watch --config /etc/it-digest/config.toml
# A oneshot unit has no start timeout by default. Bound the run so hung
# upstreams cannot stall it into the next hourly trigger: on timeout systemd
# stops the run and marks the unit failed, which fires the OnFailure alert
# above. A normal run takes seconds. Releases already posted are recorded,
# so the next run continues where this one stopped.
TimeoutStartSec=10min
# Bound memory: a normal run needs a few tens of MB. Responses are size-
# capped (the largest, Ubuntu's notices API, at 16 MiB), but a hostile or
# broken upstream must not be able to exhaust the server. GOMEMLIMIT makes
# the Go GC work harder before the hard limit is reached; exceeding
# MemoryMax kills the run, which fires the OnFailure alert.
Environment=GOMEMLIMIT=400MiB
MemoryMax=512M
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/it-digest
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
