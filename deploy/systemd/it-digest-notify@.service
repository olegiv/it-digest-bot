[Unit]
Description=it-digest-bot — failure notifier for %i

[Service]
Type=oneshot
User=it-digest
Group=it-digest
Environment=TZ=Europe/Zurich
EnvironmentFile=/etc/it-digest/env
ExecStart=/usr/local/bin/digest notify --unit %i --config /etc/it-digest/config.toml
# One Telegram send with a few retries; never let an alert hang around.
TimeoutStartSec=2min
StandardOutput=journal
StandardError=journal

# Same hardening profile as the other services.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
# Further hardening (systemd-analyze security). The services run as the
# unprivileged it-digest user and need no capabilities, devices, clock,
# hostname or kernel-log access. UMask=0077 keeps the state DB, its WAL
# files and the backups private to that user.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictRealtime=true
RemoveIPC=true
UMask=0077
