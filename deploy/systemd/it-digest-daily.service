[Unit]
Description=it-digest-bot — daily AI news digest (phase 2)
After=network-online.target
Wants=network-online.target

# Post a Telegram alert on nonzero exit (see it-digest-notify@.service).
OnFailure=it-digest-notify@%N.service

[Service]
Type=oneshot
User=it-digest
Group=it-digest
Environment=TZ=Europe/Zurich
EnvironmentFile=/etc/it-digest/env
ExecStart=/usr/local/bin/digest daily --config /etc/it-digest/config.toml
# A oneshot unit has no start timeout by default. A normal run takes under a
# minute; the slowest legitimate one (feeds timing out plus an Anthropic
# request retried at llm.timeout_seconds each) stays well below this. A run
# that hangs anyway is stopped and marked failed, which fires the OnFailure
# alert above, instead of silently swallowing the next day's digest.
TimeoutStartSec=30min
StandardOutput=journal
StandardError=journal

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/it-digest
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
# Further hardening (systemd-analyze security). The services run as the
# unprivileged it-digest user and need no capabilities, devices, clock,
# hostname or kernel-log access. UMask=0077 keeps the state DB, its WAL
# files and the backups private to that user.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectProc=invisible
RestrictRealtime=true
RemoveIPC=true
UMask=0077
