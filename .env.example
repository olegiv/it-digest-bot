# Copy to .env (or /etc/it-digest/env in production) and fill in.
# Never commit the real file — .env is gitignored.

# Required for `digest watch` and `digest daily` (anything that posts).
TELEGRAM_BOT_TOKEN=

# Required for `digest daily` (phase 2). Not needed for `digest watch`.
ANTHROPIC_API_KEY=

# Optional. A token raises GitHub's rate limit from 60 req/hour
# (unauthenticated) to 5000 req/hour for the Claude Code release-notes and
# PHP security-advisory requests. Both read public data only, so it needs no
# access: use a fine-grained personal access token with "Public
# repositories (read-only)" and no permissions. It is sent only to
# api.github.com.
GITHUB_TOKEN=
